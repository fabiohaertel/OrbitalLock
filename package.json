{
  "name": "orbital-lock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Orbital Lock - 2D arcade territory-capture puzzle game built with Phaser 4.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.0.5"
  }
}
